UID=1000
GID=1000
# Default number of stations to return per request. Default is 1000.
# 0 behaves like the default. Explicit ?limit= values are passed through
# uncapped; per-response size caps bound worst-case memory instead.
# Collection cards (genres, countries, languages) cap their displayed
# station counts at this default value, since a click fetches this many.
RADIO_BROWSER_STATION_LIMIT=1000
# Allow browsing/searching/playing without logging in (0 = login required
# for everything, the default). Favorites and account management always
# require an account. Accepts 1/true/yes/on (case-insensitive).
ALLOW_GUEST_ACCESS=0
# Enable the admin-only live stats window that shows active users/guests with
# station, IP, and active time. Accepts 1/true/yes/on.
ADMIN_STATS_ENABLED=0
# Retain activity log entries in /app/data/activity.log for this many days.
# Set to 0 to disable activity logging.
LOG_RETENTION_DAYS=0
