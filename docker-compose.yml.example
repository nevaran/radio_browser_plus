services:
  app:
    build: .
    container_name: radio-browser-plus
    ports:
      - '8000:8000'
    volumes:
      - ./data:/app/data
    environment:
      - FAVORITES_FILE=/app/data/favorites.json
      - RADIO_BROWSER_STATION_LIMIT=${RADIO_BROWSER_STATION_LIMIT:-1000}
      - RUST_LOG=info
      - RUST_BACKTRACE=0
    user: "${UID:-1000}:${GID:-1000}"
    cap_drop:
      - ALL
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
